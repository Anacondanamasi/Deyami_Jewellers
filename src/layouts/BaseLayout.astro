---
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import WhatsAppButton from '../components/global/WhatsAppButton.astro';
import Seo from '../components/seo/Seo.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const { title, description, image, type, jsonLd, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      type={type}
      jsonLd={jsonLd}
      noindex={noindex}
    />
  </head>
  <body class="bg-[#fafafa] text-neutral-900 font-sans min-h-screen flex flex-col selection:bg-neutral-900 selection:text-white">
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
