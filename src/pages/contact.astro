---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Sparkle from '../components/ui/Sparkle.astro';
import Button from '../components/ui/Button.astro';
import { siteConfig } from '../config/site';
import { getBreadcrumbSchema } from '../utils/schema';
import { getWhatsAppUrl } from '../utils/whatsapp';

const breadcrumbs = [
  { name: 'Contact & Enquiries', href: '/contact' },
];

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact' },
]);

const waUrl = getWhatsAppUrl({
  customMessage: "Hello DEYAMI, I am reaching out from your website contact page.",
});
---

<BaseLayout
  title="Contact & Concierge Enquiries"
  description="Connect with the DEYAMI silver studio. Direct WhatsApp support, custom sizing consultations, atelier address, and Netlify-protected enquiry form."
  jsonLd={breadcrumbSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
    <Breadcrumb items={breadcrumbs} />

    <SectionHeading
      eyebrow="Direct Concierge"
      title="Connect with DEYAMI"
      tagline="We'd Love to Hear From You"
      subtitle="Whether you have an enquiry about a specific jewelry piece, custom sizing, bridal sets, or silver care — our atelier is at your service."
      class="mt-6 mb-16"
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left Column: Contact Channels & Studio Info (5 Cols) -->
      <div class="lg:col-span-5 space-y-8">
        <!-- WhatsApp Quick Action Box -->
        <div class="p-8 bg-neutral-900 text-white border border-neutral-800">
          <div class="flex items-center gap-2 text-xs uppercase tracking-widest text-emerald-400 font-medium mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Fastest Response Channel</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-light uppercase tracking-wider text-white">
            WhatsApp Concierge
          </h3>
          <p class="text-xs text-neutral-300 font-light mt-2 leading-relaxed">
            Message us directly on WhatsApp for instant replies, live daylight videos of any piece, and custom sizing support.
          </p>

          <div class="mt-6">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs uppercase tracking-widest font-medium transition-colors shadow-md"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
              </svg>
              <span>Chat on WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Studio Details Card -->
        <div class="p-8 bg-white border border-neutral-200 space-y-6">
          <h4 class="text-xs uppercase tracking-widest text-neutral-900 font-semibold border-b border-neutral-100 pb-3 flex items-center gap-2">
            <Sparkle size={10} class="text-neutral-500" />
            <span>Studio Coordinates</span>
          </h4>

          <div class="space-y-4 text-xs font-light text-neutral-600">
            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">Company</span>
              <p class="text-neutral-900 font-medium">{siteConfig.legalName}</p>
              {siteConfig.gstin && (
                <p class="text-[11px] text-neutral-500 font-mono mt-0.5">GSTIN: {siteConfig.gstin}</p>
              )}
            </div>

            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">Customer Care</span>
              <a href={`tel:${siteConfig.contact.phoneRaw}`} class="text-neutral-900 font-medium hover:underline">
                {siteConfig.contact.phone}
              </a>
            </div>

            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">WhatsApp Concierge</span>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-700 font-medium hover:underline">
                {siteConfig.contact.whatsapp.display}
              </a>
            </div>

            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">Email</span>
              <a href={`mailto:${siteConfig.contact.email}`} class="text-neutral-900 font-medium hover:underline">
                {siteConfig.contact.email}
              </a>
            </div>

            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">Registered Office & Atelier</span>
              <p class="text-neutral-900 leading-relaxed">
                {siteConfig.contact.address.formatted}
              </p>
              <a
                href={siteConfig.contact.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-1 text-[11px] text-neutral-950 underline underline-offset-4 hover:text-neutral-600 font-medium"
              >
                View on Google Maps ↗
              </a>
            </div>

            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">Visiting Hours</span>
              <p class="text-neutral-900">{siteConfig.contact.hours}</p>
            </div>

            <div>
              <span class="block text-neutral-400 uppercase tracking-wider text-[10px] mb-0.5">Social</span>
              <div class="flex items-center gap-4 pt-1">
                <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="text-neutral-900 hover:text-neutral-600 underline">Instagram</a>
                <a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer" class="text-neutral-900 hover:text-neutral-600 underline">Facebook</a>
                <a href={siteConfig.socials.pinterest} target="_blank" rel="noopener noreferrer" class="text-neutral-900 hover:text-neutral-600 underline">Pinterest</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Netlify Forms Protected Form (7 Cols) -->
      <div class="lg:col-span-7 bg-white p-8 sm:p-10 border border-neutral-200">
        <h3 class="text-xl sm:text-2xl font-light uppercase tracking-wider text-neutral-900 mb-2">
          Send an Atelier Inquiry
        </h3>
        <p class="text-xs sm:text-sm text-neutral-600 font-light mb-8">
          Fill out this form and our team will get back to you via email or WhatsApp within 12 business hours.
        </p>

        <!-- Netlify Forms Configuration -->
        <form
          name="contact"
          method="POST"
          action="/success"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <!-- Hidden inputs for Netlify form processing -->
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs uppercase tracking-wider text-neutral-700 font-medium mb-1.5">
                Your Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g. Aditi Patel"
                class="w-full bg-[#fafafa] border border-neutral-300 px-4 py-3 text-xs sm:text-sm text-neutral-900 focus:outline-none focus:border-neutral-950 focus:bg-white transition-colors"
              />
            </div>

            <div>
              <label for="phone" class="block text-xs uppercase tracking-wider text-neutral-700 font-medium mb-1.5">
                Phone / WhatsApp <span class="text-red-500">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="+91 98765 43210"
                class="w-full bg-[#fafafa] border border-neutral-300 px-4 py-3 text-xs sm:text-sm text-neutral-900 focus:outline-none focus:border-neutral-950 focus:bg-white transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs uppercase tracking-wider text-neutral-700 font-medium mb-1.5">
              Email Address <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="aditi@example.com"
              class="w-full bg-[#fafafa] border border-neutral-300 px-4 py-3 text-xs sm:text-sm text-neutral-900 focus:outline-none focus:border-neutral-950 focus:bg-white transition-colors"
            />
          </div>

          <div>
            <label for="subject" class="block text-xs uppercase tracking-wider text-neutral-700 font-medium mb-1.5">
              Enquiry Type
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full bg-[#fafafa] border border-neutral-300 px-4 py-3 text-xs sm:text-sm text-neutral-900 focus:outline-none focus:border-neutral-950 focus:bg-white transition-colors"
            >
              <option value="product-inquiry">Product Availability & Pricing</option>
              <option value="custom-sizing">Ring Sizing / Chain Length Consultation</option>
              <option value="curated-gifting">Curated Gifting & Bulk Orders</option>
              <option value="bridal-keepsake">Bridal & Milestone Keepsake</option>
              <option value="silver-care">Silver Care & Maintenance</option>
              <option value="other">General Inquiry</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-xs uppercase tracking-wider text-neutral-700 font-medium mb-1.5">
              Your Message <span class="text-red-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Please share piece name, preferred size, or any specific questions..."
              class="w-full bg-[#fafafa] border border-neutral-300 px-4 py-3 text-xs sm:text-sm text-neutral-900 focus:outline-none focus:border-neutral-950 focus:bg-white transition-colors leading-relaxed"
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-4 bg-neutral-950 hover:bg-neutral-800 text-white text-xs uppercase tracking-widest font-medium transition-colors"
            >
              Submit Studio Enquiry
            </button>
          </div>

          <p class="text-[11px] text-neutral-400 font-light">
            We value your privacy. Your contact details will only be used to answer your inquiry.
          </p>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Pre-fill form if redirected with query params (?product=...&sku=...)
  function prefillContact() {
    const params = new URLSearchParams(window.location.search);
    const prod = params.get('product');
    const sku = params.get('sku');
    const msg = document.getElementById('message') as HTMLTextAreaElement;

    if (prod && msg && !msg.value) {
      msg.value = `Hello DEYAMI, I am enquiring about the ${prod}${sku ? ` (SKU: ${sku})` : ''}. Could you please share availability and details?`;
    }
  }

  prefillContact();
  document.addEventListener('astro:page-load', prefillContact);
</script>
