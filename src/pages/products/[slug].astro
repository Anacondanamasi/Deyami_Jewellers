---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import WhatsAppEnquire from '../../components/product/WhatsAppEnquire.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Sparkle from '../../components/ui/Sparkle.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getProductSchema, getBreadcrumbSchema } from '../../utils/schema';

export async function getStaticPaths() {
  const products = await getCollection('products');

  return products.map((prod) => {
    const product = prod.data;
    // Find related products in same category (excluding current)
    const related = products
      .filter((p) => p.data.slug !== product.slug && p.data.collectionSlug === product.collectionSlug)
      .map((p) => p.data)
      .slice(0, 4);

    return {
      params: { slug: product.slug },
      props: {
        product,
        relatedProducts: related.length > 0 ? related : products.filter((p) => p.data.slug !== product.slug).map((p) => p.data).slice(0, 4),
      },
    };
  });
}

const { product, relatedProducts } = Astro.props;

const productUrl = `${siteConfig.url}/products/${product.slug}`;

const breadcrumbs = [
  { name: 'All Jewelry', href: '/products' },
  { name: product.category, href: `/collections/${product.collectionSlug}` },
  { name: product.name },
];

const productJsonLd = getProductSchema(product);
const breadcrumbJsonLd = getBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'All Jewelry', url: '/products' },
  { name: product.category, url: `/collections/${product.collectionSlug}` },
  { name: product.name, url: `/products/${product.slug}` },
]);
---

<BaseLayout
  title={`${product.name} — 925 Sterling Silver`}
  description={product.description}
  image={product.images[0]}
  type="product"
  jsonLd={[productJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
    <Breadcrumb items={breadcrumbs} />

    <!-- Product Main Grid -->
    <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left Column: Gallery (7 Cols) -->
      <div class="lg:col-span-7">
        <ProductGallery images={product.images} productName={product.name} />
      </div>

      <!-- Right Column: Product Information & Action (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div class="space-y-6">
          <!-- Category & Badges -->
          <div class="flex items-center justify-between">
            <a
              href={`/collections/${product.collectionSlug}`}
              class="text-xs uppercase tracking-widest text-neutral-500 hover:text-black transition-colors font-medium"
            >
              {product.category}
            </a>
            <span class="text-[10px] uppercase tracking-wider text-neutral-600 bg-neutral-100 px-2.5 py-1 font-mono">
              SKU: {product.sku}
            </span>
          </div>

          <!-- Product Title -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-light uppercase tracking-wider text-neutral-900 leading-tight">
            {product.name}
          </h1>

          <!-- Price Display -->
          <div class="py-2 border-y border-neutral-200/80 flex items-baseline justify-between">
            {siteConfig.settings.showPrices && product.price ? (
              <div>
                <span class="text-xs text-neutral-500 uppercase tracking-wider font-light">
                  {siteConfig.settings.pricePrefix}
                </span>
                <span class="text-2xl sm:text-3xl font-medium tracking-wide text-neutral-950 ml-1">
                  {siteConfig.settings.currency}{product.price.toLocaleString('en-IN')}
                </span>
              </div>
            ) : (
              <span class="text-sm uppercase tracking-widest text-neutral-700 font-medium">
                Price On Request
              </span>
            )}

            <span class="text-[11px] uppercase tracking-widest text-emerald-700 bg-emerald-50 px-2.5 py-1 border border-emerald-200">
              In Studio Stock
            </span>
          </div>

          <!-- Description -->
          <div class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-light space-y-3">
            <p>{product.description}</p>
            {product.story && (
              <p class="italic text-neutral-800 border-l-2 border-neutral-900 pl-3 py-1 font-normal">
                "{product.story}"
              </p>
            )}
          </div>

          <!-- Primary Call to Action: WhatsApp Enquiry -->
          <div class="pt-2">
            <WhatsAppEnquire
              productName={product.name}
              productSku={product.sku}
              productUrl={productUrl}
            />
            <p class="text-[11px] text-neutral-400 mt-2 text-center">
              Tap above to speak directly with our atelier team for custom sizing, real daylight video, and delivery timelines.
            </p>
          </div>

          <!-- Technical Specifications Table -->
          <div class="pt-6 border-t border-neutral-200">
            <h2 class="text-xs uppercase tracking-widest text-neutral-900 font-semibold mb-3 flex items-center gap-2">
              <Sparkle size={10} class="text-neutral-500" />
              <span>Craftsmanship & Specifications</span>
            </h2>

            <dl class="divide-y divide-neutral-100 text-xs">
              <div class="py-2.5 flex justify-between">
                <dt class="text-neutral-500 uppercase tracking-wider">Metal Quality</dt>
                <dd class="text-neutral-900 font-medium text-right">{product.specs.material}</dd>
              </div>
              <div class="py-2.5 flex justify-between">
                <dt class="text-neutral-500 uppercase tracking-wider">Hallmark</dt>
                <dd class="text-neutral-900 font-medium text-right">{product.specs.hallmark}</dd>
              </div>
              <div class="py-2.5 flex justify-between">
                <dt class="text-neutral-500 uppercase tracking-wider">Approx Weight</dt>
                <dd class="text-neutral-900 font-medium text-right">{product.specs.weight}</dd>
              </div>
              <div class="py-2.5 flex justify-between">
                <dt class="text-neutral-500 uppercase tracking-wider">Dimensions / Size</dt>
                <dd class="text-neutral-900 font-medium text-right">{product.specs.size}</dd>
              </div>
              <div class="py-2.5 flex justify-between">
                <dt class="text-neutral-500 uppercase tracking-wider">Protective Finish</dt>
                <dd class="text-neutral-900 font-medium text-right">{product.specs.finish}</dd>
              </div>
              {product.specs.gemstone && (
                <div class="py-2.5 flex justify-between">
                  <dt class="text-neutral-500 uppercase tracking-wider">Accent Stone</dt>
                  <dd class="text-neutral-900 font-medium text-right">{product.specs.gemstone}</dd>
                </div>
              )}
              {product.specs.clasp && (
                <div class="py-2.5 flex justify-between">
                  <dt class="text-neutral-500 uppercase tracking-wider">Fastening</dt>
                  <dd class="text-neutral-900 font-medium text-right">{product.specs.clasp}</dd>
                </div>
              )}
            </dl>
          </div>

          <!-- Purity & Packaging Promise -->
          <div class="p-4 bg-neutral-100 border border-neutral-200 text-xs space-y-1.5 font-light text-neutral-600">
            <p class="font-medium text-neutral-900 uppercase tracking-wider text-[11px] flex items-center gap-1.5">
              <span>✦</span> The DEYAMI Guarantee
            </p>
            <p>Every piece includes a Certificate of Silver Authenticity, a soft velvet storage pouch, and anti-tarnish storage guidance.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="mt-24 pt-16 border-t border-neutral-200">
        <div class="text-center mb-12">
          <span class="text-xs uppercase tracking-widest text-neutral-400 font-medium">Complementary Silhouettes</span>
          <h2 class="text-2xl sm:text-3xl font-light uppercase tracking-wider text-neutral-900 mt-1">
            Pairs Beautifully With
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
          {relatedProducts.map((rel) => (
            <ProductCard product={rel} />
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
