---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sparkle from '../components/ui/Sparkle.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page Not Found (404)"
  description="The page you are looking for does not exist or has been relocated."
  noindex={true}
>
  <div class="max-w-xl mx-auto px-4 py-32 text-center">
    <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-neutral-400 font-medium mb-3">
      <Sparkle size={10} class="text-neutral-400" />
      <span>Error 404</span>
      <Sparkle size={10} class="text-neutral-400" />
    </div>

    <h1 class="text-4xl sm:text-5xl font-light uppercase tracking-wider text-neutral-900">
      Piece Relocated
    </h1>

    <p class="font-script text-2xl text-neutral-700 mt-2">
      "Lost moments find their way back."
    </p>

    <p class="mt-6 text-xs sm:text-sm text-neutral-600 font-light leading-relaxed max-w-sm mx-auto">
      The catalog page or jewelry piece you requested could not be located. It may have been updated or moved to another collection.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/" variant="primary" size="md">
        Back to Home
      </Button>
      <Button href="/products" variant="outline" size="md">
        Browse All Jewelry
      </Button>
    </div>
  </div>
</BaseLayout>
