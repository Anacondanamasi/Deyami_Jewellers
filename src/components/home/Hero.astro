---
import { siteConfig } from '../../config/site';
import Sparkle from '../ui/Sparkle.astro';
import Button from '../ui/Button.astro';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const waUrl = getWhatsAppUrl();
---

<section class="relative bg-neutral-900 text-white overflow-hidden py-24 sm:py-32 lg:py-40">
  <!-- Subtle Luxury Background Gradient & Motif -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neutral-800 via-neutral-950 to-black opacity-95"></div>
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
    <!-- Emblem Top Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 border border-white/20 bg-white/5 backdrop-blur-md mb-8">
      <Sparkle size={10} class="text-neutral-300" />
      <span class="text-[11px] uppercase tracking-[0.25em] text-neutral-300 font-light">
        Certified 925 Sterling Silver
      </span>
      <Sparkle size={10} class="text-neutral-300" />
    </div>

    <!-- Main Title & Wordmark -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-light tracking-[0.25em] uppercase text-white font-sans">
      {siteConfig.name}
    </h1>

    <!-- Script Tagline Accent -->
    <p class="font-script text-3xl sm:text-5xl lg:text-6xl text-neutral-200 mt-4 sm:mt-6 font-normal tracking-wide">
      "{siteConfig.tagline}"
    </p>

    <!-- Subtitle / Descriptive Copy -->
    <p class="mt-6 text-sm sm:text-base text-neutral-300 max-w-2xl font-light leading-relaxed">
      Handcrafted 925 sterling silver jewelry forged for life’s quiet personal milestones and grand celebrations. Hypoallergenic, hallmarked, and made to outlive passing trends.
    </p>

    <!-- Call to Actions -->
    <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <Button
        href="/collections"
        variant="primary"
        size="lg"
        class="w-full sm:w-auto !bg-white !text-neutral-950 hover:!bg-neutral-200 !border-white"
      >
        Explore Collections
      </Button>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/30 text-white hover:bg-white hover:text-black transition-all duration-300 text-xs sm:text-sm uppercase tracking-widest font-medium"
      >
        <svg class="w-4 h-4 fill-current text-emerald-400" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>Enquire on WhatsApp</span>
      </a>
    </div>

    <!-- Trust Markers -->
    <div class="mt-16 pt-8 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-6 w-full max-w-4xl text-center">
      <div>
        <p class="text-xs uppercase tracking-widest text-neutral-400">Purity</p>
        <p class="text-sm font-medium text-white mt-1">92.5% Pure Silver</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-neutral-400">Standard</p>
        <p class="text-sm font-medium text-white mt-1">BIS Hallmarked</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-neutral-400">Finish</p>
        <p class="text-sm font-medium text-white mt-1">Anti-Tarnish Rhodium</p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-neutral-400">Skin Friendly</p>
        <p class="text-sm font-medium text-white mt-1">100% Nickel-Free</p>
      </div>
    </div>
  </div>
</section>
