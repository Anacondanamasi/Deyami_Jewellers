---
import SectionHeading from '../ui/SectionHeading.astro';
import Sparkle from '../ui/Sparkle.astro';

interface CollectionItem {
  id: string;
  name: string;
  slug: string;
  tagline: string;
  description: string;
  image: string;
}

interface Props {
  collections: CollectionItem[];
}

const { collections } = Astro.props;
---

<section class="py-20 sm:py-28 bg-[#fafafa]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Curated Categories"
      title="The Collections"
      tagline="Designed for Your Everyday Moments"
      subtitle="Explore our thoughtfully designed lines, each capturing a distinctive harmony of form, brilliance, and sterling authenticity."
      class="mb-14"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        collections.map((col) => (
          <a
            href={`/collections/${col.slug}`}
            class="group relative overflow-hidden bg-white border border-neutral-200/80 hover:border-neutral-900 transition-all duration-500 flex flex-col"
          >
            <!-- Card Image -->
            <div class="relative aspect-[4/5] overflow-hidden bg-neutral-100">
              <img
                src={col.image}
                alt={`${col.name} Collection`}
                width="600"
                height="750"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/70 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-300"></div>

              <div class="absolute bottom-6 left-6 right-6 text-white">
                <span class="text-[10px] uppercase tracking-widest text-neutral-300 font-medium block mb-1">
                  925 Sterling Silver
                </span>
                <h3 class="text-xl sm:text-2xl font-light tracking-wider uppercase text-white">
                  {col.name}
                </h3>
                <p class="font-script text-lg text-neutral-200 mt-0.5 line-clamp-1">
                  {col.tagline}
                </p>
              </div>
            </div>

            <!-- Card Bottom Bar -->
            <div class="p-5 flex items-center justify-between bg-white border-t border-neutral-100">
              <span class="text-xs uppercase tracking-widest text-neutral-600 group-hover:text-black font-medium transition-colors">
                Explore Collection
              </span>
              <span class="text-neutral-400 group-hover:text-black group-hover:translate-x-1 transition-all duration-300">
                →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
