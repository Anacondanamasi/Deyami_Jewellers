---
import SectionHeading from '../ui/SectionHeading.astro';
import ProductCard from '../product/ProductCard.astro';
import Button from '../ui/Button.astro';

interface Props {
  products: any[];
}

const { products } = Astro.props;
---

<section class="py-20 sm:py-28 bg-white border-t border-neutral-200/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Just Released"
      title="Fresh Creations"
      tagline="New Expressions of Silver"
      subtitle="Discover our newest silhouettes, forged with meticulous attention to line, balance, and sparkle."
      class="mb-14"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {
        products.map((product) => (
          <ProductCard product={product} />
        ))
      }
    </div>

    <div class="mt-14 text-center">
      <Button href="/products" variant="outline" size="lg">
        Explore Complete Catalog
      </Button>
    </div>
  </div>
</section>
