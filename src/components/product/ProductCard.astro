---
import { siteConfig } from '../../config/site';
import Sparkle from '../ui/Sparkle.astro';
import { getWhatsAppUrl } from '../../utils/whatsapp';

interface Props {
  product: {
    id: string;
    name: string;
    slug: string;
    category: string;
    description: string;
    images: string[];
    price?: number;
    sku: string;
    featured?: boolean;
    newArrival?: boolean;
    tags?: string[];
  };
}

const { product } = Astro.props;

const detailUrl = `/products/${product.slug}`;
const waUrl = getWhatsAppUrl({
  productName: product.name,
  productSku: product.sku,
  productUrl: `${siteConfig.url}${detailUrl}`,
});

const primaryImg = product.images[0] || '/images/products/solitaire-spark-ring-1.jpg';
const hoverImg = product.images[1] || primaryImg;
---

<article class="group relative flex flex-col bg-white border border-neutral-200/80 hover:border-neutral-900 transition-all duration-300">
  <!-- Image Container -->
  <a href={detailUrl} class="relative block aspect-square overflow-hidden bg-neutral-100" aria-label={`View ${product.name}`}>
    <!-- Badges -->
    <div class="absolute top-3 left-3 z-10 flex flex-col gap-1.5 items-start">
      {product.newArrival && (
        <span class="bg-neutral-950 text-white text-[10px] tracking-widest uppercase px-2.5 py-1 font-medium shadow-sm">
          New
        </span>
      )}
      {product.featured && !product.newArrival && (
        <span class="bg-neutral-800 text-white text-[10px] tracking-widest uppercase px-2.5 py-1 font-medium shadow-sm">
          Featured
        </span>
      )}
      <span class="bg-white/90 backdrop-blur-sm text-neutral-800 text-[9px] tracking-widest uppercase px-2 py-0.5 border border-neutral-200 font-medium">
        925 Silver
      </span>
    </div>

    <!-- Primary Image -->
    <img
      src={primaryImg}
      alt={product.name}
      width="600"
      height="600"
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />

    <!-- Quick Hover Overlay Hint -->
    <div class="absolute inset-0 bg-neutral-950/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center p-4">
      <span class="bg-white text-neutral-900 text-[11px] uppercase tracking-widest font-medium px-4 py-2 shadow-md w-full text-center">
        View Details
      </span>
    </div>
  </a>

  <!-- Content Info -->
  <div class="p-4 sm:p-5 flex flex-col flex-1 justify-between bg-white">
    <div>
      <span class="text-[10px] uppercase tracking-widest text-neutral-400 block mb-1 font-medium">
        {product.category}
      </span>
      <h3 class="text-sm sm:text-base font-normal tracking-wide text-neutral-900 line-clamp-1 group-hover:text-neutral-600 transition-colors">
        <a href={detailUrl}>
          {product.name}
        </a>
      </h3>

      <!-- Price / Request -->
      <div class="mt-2.5 flex items-baseline gap-2">
        {siteConfig.settings.showPrices && product.price ? (
          <p class="text-xs sm:text-sm font-medium text-neutral-900 tracking-wider">
            <span class="text-[11px] text-neutral-500 font-light">{siteConfig.settings.pricePrefix}</span>
            {siteConfig.settings.currency}{product.price.toLocaleString('en-IN')}
          </p>
        ) : (
          <p class="text-xs text-neutral-600 tracking-wider uppercase font-medium">
            Price on Request
          </p>
        )}
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between gap-2">
      <a
        href={detailUrl}
        class="text-[11px] uppercase tracking-wider text-neutral-600 hover:text-black transition-colors"
      >
        Explore Piece →
      </a>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-emerald-700 hover:text-emerald-800 font-medium p-1 transition-colors"
        title="Enquire on WhatsApp"
        aria-label={`Enquire on WhatsApp about ${product.name}`}
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>Enquire</span>
      </a>
    </div>
  </div>
</article>
