---
import { siteConfig } from '../../config/site';
import Sparkle from '../ui/Sparkle.astro';
import MobileMenu from './MobileMenu.astro';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const currentPath = Astro.url.pathname;
const waUrl = getWhatsAppUrl();
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-neutral-200/80 transition-shadow duration-300">
  <!-- Top Announcement / Brand Tagline Bar -->
  <div class="bg-neutral-950 text-white text-[11px] py-1.5 px-4 text-center tracking-widest uppercase flex items-center justify-center gap-2">
    <Sparkle size={9} class="text-neutral-400" />
    <span class="font-light">Authentic 925 Sterling Silver</span>
    <span class="text-neutral-600 hidden sm:inline">•</span>
    <span class="font-script text-sm capitalize hidden sm:inline font-normal text-neutral-300">"{siteConfig.tagline}"</span>
    <span class="text-neutral-600 hidden sm:inline">•</span>
    <span class="font-light hidden md:inline">Pan-India Insured Dispatch</span>
    <Sparkle size={9} class="text-neutral-400" />
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo & Wordmark -->
    <a href="/" class="flex items-center gap-3.5 group focus:outline-none" aria-label="DEYAMI Home">
      <img
        src={siteConfig.logo.transparent}
        alt="DEYAMI 925 Sterling Silver Emblem"
        width="48"
        height="48"
        class="h-11 w-11 sm:h-12 sm:w-12 object-contain transition-transform duration-300 group-hover:scale-105"
        loading="eager"
      />
      <div class="flex flex-col">
        <span class="text-xl sm:text-2xl font-light tracking-[0.22em] uppercase text-neutral-950 group-hover:text-neutral-700 transition-colors">
          {siteConfig.name}
        </span>
        <span class="text-[9px] uppercase tracking-[0.3em] text-neutral-500 -mt-1 font-medium">
          {siteConfig.descriptor}
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center space-x-7" aria-label="Main Navigation">
      {
        siteConfig.nav.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`text-[12px] uppercase tracking-widest font-medium transition-colors relative py-1 hover:text-black ${
                isActive ? 'text-black font-semibold' : 'text-neutral-600'
              }`}
            >
              {item.title}
              {isActive && (
                <span class="absolute bottom-0 left-0 right-0 h-[1.5px] bg-black" />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Header Action CTA & Mobile Toggle -->
    <div class="flex items-center gap-3 sm:gap-4">
      <!-- WhatsApp Direct Enquire Button (Desktop & Tablet) -->
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 border border-neutral-900 text-[11px] uppercase tracking-widest font-medium hover:bg-neutral-950 hover:text-white transition-all duration-300"
        aria-label="Direct WhatsApp Enquiry"
      >
        <svg class="w-3.5 h-3.5 fill-current text-emerald-600" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>Enquire</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-open-btn"
        type="button"
        class="lg:hidden p-2 text-neutral-800 hover:text-black focus:outline-none"
        aria-label="Open mobile menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<MobileMenu />
