---
import { siteConfig } from '../../config/site';
import Sparkle from '../ui/Sparkle.astro';
import { getWhatsAppUrl } from '../../utils/whatsapp';

const waUrl = getWhatsAppUrl();
const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-950 text-white pt-16 pb-12 border-t border-neutral-900 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8 pb-12 border-b border-neutral-800">
      <!-- Col 1: Brand Info (2 spans on desktop) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="inline-flex items-center gap-3">
          <img
            src={siteConfig.logo.transparent}
            alt={siteConfig.name}
            width="44"
            height="44"
            class="h-11 w-11 object-contain invert"
            loading="lazy"
          />
          <div>
            <span class="text-xl font-light tracking-[0.25em] uppercase text-white block">
              {siteConfig.name}
            </span>
            <span class="text-[9px] uppercase tracking-[0.3em] text-neutral-400 block -mt-1 font-medium">
              {siteConfig.descriptor}
            </span>
          </div>
        </a>

        <p class="font-script text-2xl text-neutral-300">
          "{siteConfig.tagline}"
        </p>

        <p class="text-xs text-neutral-400 leading-relaxed max-w-sm font-light">
          {siteConfig.subtagline} Each piece is forged in certified 925 sterling silver, hallmarked for purity, and finished with anti-tarnish rhodium protection.
        </p>

        <!-- Purity Assurance Badge -->
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 border border-neutral-800 bg-neutral-900/60 text-neutral-300 text-[11px] uppercase tracking-wider">
          <Sparkle size={10} class="text-neutral-400" />
          <span>100% Certified 925 BIS Hallmarked</span>
        </div>
      </div>

      <!-- Col 2: Collections -->
      <div>
        <h3 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4 flex items-center gap-2">
          <span>Collections</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-neutral-400">
          <li><a href="/collections/rings" class="hover:text-white transition-colors">Rings & Bands</a></li>
          <li><a href="/collections/earrings" class="hover:text-white transition-colors">Earrings & Huggies</a></li>
          <li><a href="/collections/necklaces" class="hover:text-white transition-colors">Necklaces & Pendants</a></li>
          <li><a href="/collections/bracelets" class="hover:text-white transition-colors">Bracelets & Cuffs</a></li>
          <li><a href="/collections/anklets" class="hover:text-white transition-colors">Anklets & Payals</a></li>
          <li><a href="/collections/gifting-sets" class="hover:text-white transition-colors">Curated Gifting Sets</a></li>
          <li><a href="/products" class="hover:text-white transition-colors font-medium text-neutral-200">View All Jewelry →</a></li>
        </ul>
      </div>

      <!-- Col 3: Guides & Brand -->
      <div>
        <h3 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4 flex items-center gap-2">
          <span>Explore & Care</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-neutral-400">
          <li><a href="/about" class="hover:text-white transition-colors">Our Story & Craft</a></li>
          <li><a href="/guides/silver-care" class="hover:text-white transition-colors">Silver Care Guide</a></li>
          <li><a href="/guides/silver-purity" class="hover:text-white transition-colors">925 Purity Guide</a></li>
          <li><a href="/faq" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact & Enquiries</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Enquiries -->
      <div>
        <h3 class="text-xs uppercase tracking-widest text-neutral-300 font-semibold mb-4 flex items-center gap-2">
          <span>Client Concierge</span>
        </h3>
        <div class="space-y-3 text-xs text-neutral-400 font-light">
          <p>
            <span class="block text-neutral-500 text-[10px] uppercase tracking-wider">WhatsApp Enquiries</span>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-white hover:text-emerald-400 transition-colors font-medium">
              {siteConfig.contact.whatsapp.display}
            </a>
          </p>
          <p>
            <span class="block text-neutral-500 text-[10px] uppercase tracking-wider">Email Us</span>
            <a href={`mailto:${siteConfig.contact.email}`} class="text-white hover:text-neutral-300 transition-colors">
              {siteConfig.contact.email}
            </a>
          </p>
          <p>
            <span class="block text-neutral-500 text-[10px] uppercase tracking-wider">Studio Location</span>
            <span>{siteConfig.contact.address.street}, {siteConfig.contact.address.city}, {siteConfig.contact.address.state}</span>
          </p>
          <p>
            <span class="block text-neutral-500 text-[10px] uppercase tracking-wider">Hours</span>
            <span>{siteConfig.contact.hours}</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 font-light">
      <p>
        &copy; {currentYear} {siteConfig.legalName}. All rights reserved.
      </p>

      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="hover:text-neutral-300 transition-colors">Privacy Policy</a>
        <span class="text-neutral-800">•</span>
        <a href="/terms" class="hover:text-neutral-300 transition-colors">Terms of Service</a>
        <span class="text-neutral-800">•</span>
        <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-300 transition-colors">
          Instagram
        </a>
      </div>
    </div>
  </div>
</footer>
