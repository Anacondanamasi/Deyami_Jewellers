---
interface Props {
  size?: number;
  class?: string;
  fill?: string;
}

const { size = 16, class: className = '', fill = 'currentColor' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={fill}
  class={`inline-block ${className}`}
  aria-hidden="true"
>
  <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" />
</svg>
