---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'whatsapp' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel,
  id,
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium transition-all duration-300 tracking-wider uppercase focus:outline-none focus:ring-2 focus:ring-offset-2';

const sizeStyles = {
  sm: 'px-4 py-2 text-xs',
  md: 'px-6 py-3 text-xs sm:text-sm',
  lg: 'px-8 py-4 text-sm tracking-widest',
};

const variantStyles = {
  primary: 'bg-neutral-950 text-white hover:bg-neutral-800 border border-neutral-950 focus:ring-neutral-900',
  secondary: 'bg-neutral-100 text-neutral-900 hover:bg-neutral-200 border border-neutral-200 focus:ring-neutral-400',
  outline: 'bg-transparent text-neutral-900 hover:bg-neutral-900 hover:text-white border border-neutral-900 focus:ring-neutral-900',
  whatsapp: 'bg-emerald-600 hover:bg-emerald-700 text-white border border-emerald-600 focus:ring-emerald-500 shadow-sm',
  ghost: 'bg-transparent text-neutral-800 hover:text-black hover:bg-neutral-100 border border-transparent',
};

const classes = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} id={id}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} id={id}>
      <slot />
    </button>
  )
}
